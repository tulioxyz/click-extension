{
  "manifest_version": 3,
  "name": "Auto Clicker em Lote",
  "version": "1.2.0",
  "description": "Painel flutuante e 100% arrastável na tela para automatizar cliques em ações de tabelas.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Auto Clicker em Lote (Clique para abrir/fechar o painel arrastável)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
